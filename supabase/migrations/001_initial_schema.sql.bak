-- ============================================
-- 7. 實用的 View（可選）
-- ============================================

-- View: 用戶收藏統計
CREATE OR REPLACE VIEW public.user_collection_stats AS
SELECT 
  u.id as user_id,
  u.email,
  u.display_name,
  COUNT(uc.id) as total_collections,
  COUNT(CASE WHEN uc.collected_date IS NOT NULL THEN 1 END) as collected_count,
  MAX(uc.created_at) as last_collection_date
FROM public.users u
LEFT JOIN public.user_collections uc ON u.id = uc.user_id
GROUP BY u.id, u.email, u.display_name;

-- View: 爬蟲執行統計
CREATE OR REPLACE VIEW public.scraper_stats AS
SELECT 
  ss.id as source_id,
  ss.source_name,
  ss.is_active,
  ss.last_scraped_at,
  COUNT(sl.id) as total_runs,
  COUNT(CASE WHEN sl.status = 'success' THEN 1 END) as success_count,
  COUNT(CASE WHEN sl.status = 'failed' THEN 1 END) as failed_count,
  SUM(sl.items_scraped) as total_items_scraped,
  MAX(sl.executed_at) as last_run_at
FROM public.scraper_sources ss
LEFT JOIN public.scraper_logs sl ON ss.id = sl.source_id
GROUP BY ss.id, ss.source_name, ss.is_active, ss.last_scraped_at;

-- ============================================
-- 8. 輔助函數
-- ============================================

-- Function: 檢查用戶是否為 admin
CREATE OR REPLACE FUNCTION public.is_admin(user_id uuid)
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  RETURN EXISTS (
    SELECT 1 FROM public.users 
    WHERE id = user_id AND is_admin = true
  );
END;
$$;

-- Function: 取得用戶收藏數量
CREATE OR REPLACE FUNCTION public.get_user_collection_count(user_id uuid)
RETURNS integer
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  collection_count integer;
BEGIN
  SELECT COUNT(*) INTO collection_count
  FROM public.user_collections
  WHERE user_collections.user_id = get_user_collection_count.user_id;
  
  RETURN collection_count;
END;
$$;

-- ============================================
-- Phase 1 完成
-- ============================================

-- 顯示建立的表格
SELECT 
  schemaname,
  tablename,
  tableowner
FROM pg_tables
WHERE schemaname = 'public'
ORDER BY tablename;

-- 顯示 RLS 狀態
SELECT 
  schemaname,
  tablename,
  rowsecurity
FROM pg_tables
WHERE schemaname = 'public'
ORDER BY tablename;
