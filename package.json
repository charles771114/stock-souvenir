{
  "name": "stock-souvenir",
  "private": true,
  "version": "3.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "lint": "eslint src --ext .js,.vue",
    "test:unit": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "supabase:test": "node scripts/test-supabase-connection.js",
    "supabase:create-user": "node scripts/create-test-user.js",
    "sync:supabase": "node scripts/sync-sheets-to-supabase.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && supabase db execute -f supabase/schema.sql && supabase db execute -f supabase/seed.sql",
    "db:seed": "supabase db execute -f supabase/seed.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "axios": "^1.6.5",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.530",
    "pinia": "^2.1.7",
    "sweetalert2": "^11.26.18",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue3-loading-overlay": "^0.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}